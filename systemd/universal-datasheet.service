[Unit]
Description=Universal DataSheet Studio (Multimarcas com IA Local)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/universal-datasheet
Environment=PORT=8098
Environment=OLLAMA_URL=http://10.88.30.12:11434
ExecStart=/usr/bin/node server.mjs
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target

